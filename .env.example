# --- Telegram ---------------------------------------------------------
BOT_TOKEN=123456:replace-me
# Telegram IDs allowed into the admin panel. "1,2" or "[1,2]".
ADMIN_IDS=

# --- Storage ----------------------------------------------------------
# Used by the postgres service and by the bot's DATABASE_URL below.
POSTGRES_USER=rillza
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=rillza

DATABASE_URL=postgresql+asyncpg://rillza:replace-me@postgres:5432/rillza
REDIS_URL=redis://redis:6379/0

# --- CELERITY panel ---------------------------------------------------
PANEL_BASE_URL=https://link.rillza-service.com
# Panel -> Settings -> Security -> API Keys, scopes:
# users:read, users:write, stats:read
PANEL_API_KEY=ck_replace-me
# Server group new users are attached to; resolved to its id on startup.
PANEL_GROUP_NAME=Rillza

# --- Product ----------------------------------------------------------
TRIAL_DAYS=3
INVOICE_TTL_MINUTES=30

# --- Payments ---------------------------------------------------------
YOOMONEY_ACCESS_TOKEN=
# Wallet number; read from the API on startup when left empty.
YOOMONEY_WALLET=
# AC = pay by bank card, PC = pay from a YooMoney wallet balance.
YOOMONEY_PAYMENT_TYPE=AC
CRYPTOBOT_TOKEN=

# --- Happ download links (shown in the connection guide) --------------
HAPP_IOS_URL=https://apps.apple.com/app/id6504287215
HAPP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.happproxy
HAPP_SITE_URL=https://happ.su

# --- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
# Optional: mirror logs into a Telegram chat via a second bot.
LOG_BOT_TOKEN=
LOG_CHAT_ID=
LOG_TELEGRAM_LEVEL=WARNING
